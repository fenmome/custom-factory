# ---- 运行环境 ----
ENVIRONMENT=development

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=cf_dev_root
DB_PASSWORD=cf_dev_password
DATABASE_URL=mysql+pymysql://cf_user:cf_dev_password@mysql:3306/custom_factory?charset=utf8mb4

# ---- 缓存 ----
REDIS_URL=redis://redis:6379/0

# ---- 安全 ----
SECRET_KEY=please-change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_HOURS=8

# ---- 存储（禁止在项目根目录之外） ----
STORAGE_ROOT=./data/images
PLAN_STORE_ROOT=./data/plans

# ---- CORS ----
CORS_ORIGINS=["http://localhost:35173","http://127.0.0.1:35173"]

# ---- 图片生成（可选，API 路线） ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-image-1

# ---- Codex Runner ----
RUNNER_TOKEN=please-change-me-runner-token-at-least-32-chars

# ---- 标题池（离线导入） ----
TITLE_POOL_VERSION=1.3.0
